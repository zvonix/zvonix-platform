{
  "name": "zvonix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "pnpm --filter @zvonix/api dev",
    "check": "bash scripts/check.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @zvonix/db db:generate",
    "db:migrate": "pnpm --filter @zvonix/db db:migrate",
    "admin:create": "pnpm --filter @zvonix/api admin:create"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
