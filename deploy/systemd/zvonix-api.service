# API площадки (ADR-0049). Слушает только 127.0.0.1: наружу его отдаёт обратный прокси.
[Unit]
Description=Zvonix API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=zvonix
Group=zvonix
WorkingDirectory=/opt/zvonix/current/apps/api
EnvironmentFile=/etc/zvonix/zvonix.env
# Записи разговоров (ADR-0063): каталог создаёт и отдаёт службе сам systemd, и он остаётся
# записываемым при ProtectSystem=strict. Вне каталога выпуска — выкладка записи не стирает.
StateDirectory=zvonix-recordings
StateDirectoryMode=0750
Environment=RECORDINGS_DIR=/var/lib/zvonix-recordings
ExecStart=/usr/bin/node --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Заявки на обновление из кабинета (ADR-0074): единственное место вне своих каталогов, куда API пишет.
# Дефис — каталога может не быть (площадка до первой выкладки со службой обновления).
ReadWritePaths=-/var/lib/zvonix-updater/requests

[Install]
WantedBy=multi-user.target
