# API площадки (ADR-0049). Слушает только 127.0.0.1: наружу его отдаёт обратный прокси.
[Unit]
Description=Zvonix API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=zvonix
Group=zvonix
WorkingDirectory=/opt/zvonix/current/apps/api
EnvironmentFile=/etc/zvonix/zvonix.env
ExecStart=/usr/bin/node --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
