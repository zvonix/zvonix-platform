{
  "name": "@zvonix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "dev": "concurrently -n tsc,api -c blue,green \"tsc --build --watch --preserveWatchOutput ../../tsconfig.json\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "admin:create": "node dist/modules/identity/create-admin.js",
    "numbers:resolve": "node dist/modules/catalog/resolve-batch.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@node-rs/argon2": "^2.2.0",
    "@zvonix/config": "workspace:*",
    "@zvonix/db": "workspace:*",
    "@zvonix/logger": "workspace:*",
    "@zvonix/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  }
}
