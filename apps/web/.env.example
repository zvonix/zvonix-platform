# Переменные кабинета. Отдельно от корневого .env.example: там ровно те переменные,
# что читает конфигурация API и воркера (ADR-0002), и лишнее имя там ломает проверку.

# Адрес API в разработке: по нему Next проксирует /api/*.
# В production не используется — там кабинет и API делит обратный прокси (ADR-0037).
ZVONIX_API_ORIGIN=http://127.0.0.1:8000
