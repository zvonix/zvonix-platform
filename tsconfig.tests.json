{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Проверка типов тестового кода — всего, где бы он ни лежал.
  //
  // Отдельным проектом, потому что тесты **не собираются**: до этого они входили
  // в проект своего пакета, и `tsc --build` укладывал семьдесят скомпилированных
  // проверок в `dist` рядом с приложением. В артефакте им делать нечего: под vitest
  // они читаются из исходников (ADR-0017), а в production не вызываются вовсе.
  //
  // Проект ничего не порождает (`noEmit`) и потому не может быть ссылкой ни для кого:
  // TypeScript запрещает ссылаться на проект без вывода (TS6310). Это и требуется —
  // он лист, его строит только корневой `tsconfig.json`.
  //
  // Исходники пакетов попадают сюда вторым проходом: тест импортирует проверяемый
  // модуль, и TypeScript берёт его исходник, а не объявления из `dist`. Так и нужно —
  // иначе проверка типов теста отставала бы от последней правки.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,

    // Те же две опции, что у API и воркера: через импорты сюда втягиваются
    // исходники с декораторами NestJS, и режим их разбора обязан совпадать.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["apps/*/src/**/*.test.ts", "packages/*/src/**/*.test.ts", "tests/**/*.ts"],
  // Кабинет живёт по своим правилам: свой `tsconfig.json` с JSX, объявлениями
  // маршрутов Next и библиотекой DOM. Его проверяет собственная сборка
  // (`pnpm web:build`), и втягивать его сюда — значит проверять React
  // настройками Node.
  "exclude": ["apps/web/**"],
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/config" },
    { "path": "packages/logger" },
    { "path": "packages/db" },
    { "path": "apps/api" },
    { "path": "apps/worker" }
  ]
}
