# --- Секреты и локальное окружение ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Зависимости ---
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.py[cod]

# --- Сборка ---
# tsbuildinfo — кэш инкрементальной сборки TypeScript. Меняется при каждом запуске
# `tsc --build`, поэтому в истории от него только шум и конфликты слияния.
*.tsbuildinfo
dist/
build/
out/
target/
*.egg-info/
# Сборка Next: кэш и результат `next build`.
.next/
# Порождается Next при каждом запуске, и содержимое зависит от того, что было
# последним — сборка или разработка. В истории от него только шум.
next-env.d.ts

# --- Кэши инструментов ---
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
*.log
# Снимки и журналы браузера из MCP-сервера playwright.
.playwright-mcp/

# --- IDE / ОС ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (локальные, не общие настройки) ---
.claude/settings.local.json
start.md

# Сквозные проверки кабинета: отчёты и следы упавших проверок.
test-results/
playwright-report/
