# Пример конфигурации. Скопировать в .env и заполнить.
# .env в git не попадает (см. .gitignore). Здесь — только безопасные заглушки.
#
# Правило (ADR-0002): каждая переменная, которую читает приложение, должна быть
# и в схеме модуля конфигурации, и в этом файле. Добавляется одновременно в оба места.

# --- Приложение ---
APP_ENV=development          # development | production
APP_NAME=zvonix
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Логирование (ADR-0004) ---
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=pretty            # pretty локально, json в production

# --- Хранилище ---
# DATABASE_URL=              # TODO: заполнить после выбора СУБД

# --- Секреты ---
# Реальные значения только в локальном .env и в секретах CI/прода.
# SECRET_KEY=
