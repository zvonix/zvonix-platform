# Пример конфигурации. Скопировать в .env и заполнить.
# .env в git не попадает (см. .gitignore). Здесь — только безопасные заглушки.
#
# Правило (ADR-0002): каждая переменная, которую читает приложение, должна быть
# и в схеме модуля конфигурации, и в этом файле. Соответствие проверяется тестом
# в packages/config, поэтому забыть одно из двух не получится.

# --- Приложение ---
APP_ENV=development          # development | test | production
APP_NAME=zvonix
APP_HOST=127.0.0.1
APP_PORT=8000

# Адрес, по которому control plane виден снаружи. Из него собирается команда установки
# узла и адреса, которые узел пишет себе в конфигурацию. APP_HOST для этого не годится:
# там адрес, который слушает процесс, и за обратным прокси это 127.0.0.1 — узел
# обратился бы сам к себе. В production обязателен https: по этому каналу уходит
# секрет машинного ключа в схеме Basic (ADR-0019).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Realm SIP — общий для всей платформы, а не свой у каждого узла. Digest-проверка SIP
# считает MD5(имя:realm:пароль), и в базе хранится именно этот хеш вместо пароля.
# Свой realm у каждого узла означал бы, что учётная запись шлюза годится только
# на одном узле. МЕНЯТЬ ПОСЛЕ ВЫДАЧИ УЧЁТНЫХ ЗАПИСЕЙ НЕЛЬЗЯ: все шлюзы отвалятся разом.
SIP_REALM=sip.zvonix.local

# Предельная длительность вызова в секундах: от неё считается сумма резерва.
# Слишком мало — обрежет длинный разговор, слишком много — заморозит лишние деньги
# клиента и сократит число одновременных вызовов, которые он может начать.
MAX_CALL_DURATION_SECONDS=3600

# Через сколько секунд резерв освобождается сам. Страховка от потерянного CDR.
# Обязательно больше MAX_CALL_DURATION_SECONDS, иначе резерв истечёт посреди разговора.
RESERVATION_TTL_SECONDS=7200

# --- Сообщения MAX (ADR-0071) ---
# Через кого ходит доступ к мессенджеру: green_api либо simulated (без внешних вызовов, для
# разработки и проверок). Ключ партнёрского доступа провайдера задаётся в «Настройки площадки».
MESSENGER_PROVIDER=green_api

# --- Записи разговоров (объектное хранилище) ---
# Записи не лежат ни в базе, ни на узле: объём растёт линейно и бесконечно,
# а узел одноразов и заменяем. Узел получает подписанную ссылку на один объект
# и никогда — ключи хранилища: они дали бы доступ ко ВСЕМ записям всех клиентов.
# Где лежат записи: local — каталог на диске площадки (ADR-0063), s3 — объектное хранилище.
# При local переменные S3_* не читаются.
RECORDINGS_STORAGE=local
RECORDINGS_DIR=./data/recordings
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=zvonix-recordings
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Срок жизни подписанной ссылки, в секундах. Короткий намеренно: ссылка даёт доступ
# к разговору без всякой проверки прав, и пересланная в мессенджере она должна
# протухнуть раньше, чем её откроют посторонние.
RECORDING_LINK_TTL_SECONDS=900

# --- Логирование (ADR-0004) ---
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=pretty            # pretty локально, json в production

# --- Хранилище ---
DATABASE_URL=postgresql://zvonix:zvonix@127.0.0.1:5432/zvonix

# Соединений с базой на один процесс. Сумма по всем процессам всех узлов не должна
# превышать max_connections на сервере PostgreSQL (по умолчанию 100).
DATABASE_POOL_MAX=10

# Расписание и очередь фоновых задач (ADR-0020), в дальнейшем — счётчики лимитов.
# Состояния домена здесь нет: источник истины — PostgreSQL, и потеря всей базы Redis
# означает пропуск нескольких проходов уборки, а не потерю данных.
# Обязательна политика maxmemory-policy noeviction: при вытеснении Redis выбрасывает
# ключи заданий молча. Воркер проверяет это при старте и без неё не запускается.
REDIS_URL=redis://127.0.0.1:6379

# Базу для интеграционных тестов задаёт отдельная переменная TEST_DATABASE_URL
# (по умолчанию postgresql://zvonix:zvonix@127.0.0.1:5432/zvonix_test).
# Здесь её нет намеренно: приложение её не читает, а этот файл описывает ровно то,
# что читает приложение — соответствие проверяется тестом в packages/config.

# --- Защита входа ---
# Кому верить, когда в запросе есть X-Forwarded-For. От этого зависит request.ip,
# а от него — список разрешённых адресов машинного ключа (ADR-0019), ограничение
# частоты входа и адрес в журнале аудита. Доверять заголовку от кого угодно нельзя:
# его ставит клиент, и тогда украденный ключ узла работает откуда угодно.
# По умолчанию — только локальные адреса (обратный прокси на той же машине).
# Прокси на отдельной машине перечисляется явно: адреса, подсети или loopback,
# linklocal, uniquelocal через запятую.
TRUSTED_PROXIES=loopback

# Ограничение частоты входа и регистрации по адресу источника. Блокировка отдельной
# учётной записи перебор по множеству записей не ловит: на каждую приходится
# одна-две попытки. Считает Redis; при его недоступности проверка пропускается,
# потому что блокировка записи остаётся, а отказ закрыл бы вход и администратору.
# Выключать только осознанно: в production это снятая защита.
AUTH_RATE_LIMIT_ENABLED=true

# Сколько изменяющих обращений в минуту допустимо одной учётной записи (ADR-0041).
# Считаются POST, PUT, PATCH и DELETE от человека. Машинный контур (узел АТС) сюда
# не попадает: его объём — это телефония, и предел означал бы несостоявшиеся звонки.
# Вход и регистрация считаются отдельно и по адресу — это другая угроза.
# Redis недоступен — обращение проходит: это предел объёма, а не рубеж доступа.
# Ноль выключает счётчик; в production это снятый предел.
WRITE_RATE_LIMIT_PER_MINUTE=120

# Сколько шлюзов и SIM партнёр заводит себе сам (ADR-0043). Предел не про злой умысел,
# а про то, что заведение перестало проходить через человека: раньше объём ограничивал
# администратор тем, что печатал сам. Числа с большим запасом — GOIP-32 несёт тридцать
# две карты. Мешает — значит пора поднять. Ноль снимает ограничение; администратора
# оно не касается вовсе.
PARTNER_GATEWAY_LIMIT=50
PARTNER_SIM_LIMIT=1000

# --- Клиентский API (ADR-0044) ---
# Обращений в минуту на ОДИН клиентский ключ. Считаются и чтения, в отличие от людей:
# интеграция опрашивает состояние вызовов, и предел, не считающий опрос, ничего не держит.
# Ключи узлов под этот предел не попадают — их объём это телефония (ADR-0041).
# Ноль снимает предел.
CLIENT_API_RATE_LIMIT_PER_MINUTE=600
# Сколько действующих ключей клиент заводит себе сам. Отозванные не считаются.
CLIENT_API_KEY_LIMIT=10

# --- Пакеты для узлов АТС (ADR-0045) ---
# Свой репозиторий: в репозиториях Ubuntu FreeSWITCH нет, а раздача SignalWire требует
# их токена — подъём узла зависел бы от чужого сайта. Пока адрес пуст, GET /install.sh
# отказывает и называет эту переменную: команда, ведущая в неработающую установку,
# хуже отсутствующей. Порядок сборки репозитория — в node/README.md.
NODE_PACKAGE_REPO_URL=
# Выпуск Ubuntu, под который собраны пакеты, он же имя набора в репозитории.
NODE_PACKAGE_SUITE=noble
# Отпечаток ключа подписи (40 шестнадцатеричных цифр). Пусто — доверие только к TLS,
# и скрипт установки говорит об этом вслух.
NODE_PACKAGE_KEY_FINGERPRINT=

# --- Определение оператора номера (ADR-0013) ---
# Внешний сервис доступен только с российских IP и предоставляется «как есть».
# Выключение оставляет только план нумерации, а он оператора НЕ подтверждает —
# значит вызовы будут отклоняться. Выключать осознанно.
OPERATOR_LOOKUP_ENABLED=true
OPERATOR_LOOKUP_URL=http://num.voxlink.ru/get/

# Лимит источника — 10 запросов/с. Держимся заметно ниже: бесплатный сервис
# без гарантий легко потерять, выжигая его нагрузкой.
OPERATOR_LOOKUP_RPS=2

# --- План нумерации (ADR-0032) ---
# Кому выделен диапазон номеров. Это третья, самая слабая ступень определения
# оператора: она говорит, кому диапазон ВЫДЕЛЕН, а не кто обслуживает номер сейчас,
# и вызов по ней не совершается. Без неё номер, который не смог определить внешний
# сервис, не определяется вовсе.
# Обновляется фоновой задачей раз в сутки. Выключать на машине разработчика
# и в проверках: скачивать три мегабайта ради прогона тестов незачем.
NUMBERING_PLAN_ENABLED=true

# Выгрузка Минцифры, диапазоны DEF-9xx (мобильные). Файлы ABC не берутся:
# 59 МБ фиксированной связи, на которую платформа не звонит.
NUMBERING_PLAN_URL=https://opendata.digital.gov.ru/downloads/DEF-9xx.csv

# Срок годности записи об операторе, суток. Номер могут перенести повторно,
# а ложная запись означает платный звонок вместо бесплатного.
NUMBER_RESOLUTION_TTL_DAYS=30

# --- Почта и капча настраиваются в админке, а не здесь (ADR-0031) ---
# Узел SMTP, порт, учётные данные, отправитель и ключи Яндекс SmartCaptcha живут
# в таблице platform_settings и правятся через `PUT /settings`. Секреты там шифруются
# ключом, выведенным из SECRET_KEY. Значений по умолчанию из окружения нет намеренно:
# у одного значения не должно быть двух источников.
#
# Свежая установка почты не имеет: приложение работает, письма копятся
# в таблице outbox_messages, воркер предупреждает об этом каждым проходом (ADR-0029).
# Капча выключена.

# Адрес кабинета: из него собираются ссылки в письмах, и по нему же cookie входа
# получает Secure — у адреса на https (ADR-0037, ревизия).
# Это не PUBLIC_BASE_URL — тот адрес control plane, куда ходят узлы.
WEB_BASE_URL=http://127.0.0.1:3000

# --- Секреты ---
# Реальные значения только в локальном .env и в секретах CI и прода.
# Не короче 32 символов: openssl rand -hex 32
#
# Из SECRET_KEY выводится ключ шифрования секретов второго фактора
# (ADR-0028). Его потеря означает потерю вторых факторов у всех:
# их придётся сбросить администратору. Менять — только осознанно.
SECRET_KEY=замените-на-случайное-значение-длиной-не-менее-32-символов
