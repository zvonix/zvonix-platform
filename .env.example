# Пример конфигурации. Скопировать в .env и заполнить.
# .env в git не попадает (см. .gitignore). Здесь — только безопасные заглушки.
#
# Правило (ADR-0002): каждая переменная, которую читает приложение, должна быть
# и в схеме модуля конфигурации, и в этом файле. Соответствие проверяется тестом
# в packages/config, поэтому забыть одно из двух не получится.

# --- Приложение ---
APP_ENV=development          # development | test | production
APP_NAME=zvonix
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Логирование (ADR-0004) ---
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=pretty            # pretty локально, json в production

# --- Хранилище ---
DATABASE_URL=postgresql://zvonix:zvonix@127.0.0.1:5432/zvonix

# Соединений с базой на один процесс. Сумма по всем процессам всех узлов не должна
# превышать max_connections на сервере PostgreSQL (по умолчанию 100).
DATABASE_POOL_MAX=10

# Базу для интеграционных тестов задаёт отдельная переменная TEST_DATABASE_URL
# (по умолчанию postgresql://zvonix:zvonix@127.0.0.1:5432/zvonix_test).
# Здесь её нет намеренно: приложение её не читает, а этот файл описывает ровно то,
# что читает приложение — соответствие проверяется тестом в packages/config.

# --- Секреты ---
# Реальные значения только в локальном .env и в секретах CI и прода.
# Не короче 32 символов: openssl rand -hex 32
SECRET_KEY=замените-на-случайное-значение-длиной-не-менее-32-символов
