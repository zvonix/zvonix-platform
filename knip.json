{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.mjs", "tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/modules/identity/create-admin.ts",
        "src/modules/catalog/resolve-batch.ts",
        "src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
