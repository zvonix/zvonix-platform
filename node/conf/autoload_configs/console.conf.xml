<configuration name="console.conf" description="Консоль">
  <mappings>
    <map name="all" value="console,info,notice,warning,err,crit,alert"/>
  </mappings>
  <settings>
    <param name="colorize" value="false"/>
    <param name="loglevel" value="$${console_loglevel}"/>
  </settings>
</configuration>
