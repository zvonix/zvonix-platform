<configuration name="modules.conf" description="Модули узла">
  <!--
    Ровно то, что собирает node/build-freeswitch.sh, и ни одного лишнего (ADR-0051).
    Штатный список грузил голосовую почту, конференции, Lua и ещё десяток модулей,
    которых на узле нет, — [CRIT] в журнале на каждом старте.

    Порядок значим: таймер и привязки к площадке — раньше профиля SIP, чтобы к его
    первому запросу они уже были.
  -->
  <modules>
    <load module="mod_console"/>
    <load module="mod_logfile"/>

    <load module="mod_timerfd"/>

    <load module="mod_event_socket"/>
    <load module="mod_xml_curl"/>
    <load module="mod_json_cdr"/>

    <load module="mod_sofia"/>

    <load module="mod_commands"/>
    <load module="mod_dptools"/>
    <load module="mod_hash"/>
    <load module="mod_spandsp"/>
    <load module="mod_dialplan_xml"/>

    <load module="mod_g723_1"/>
    <load module="mod_g729"/>
    <load module="mod_amr"/>
    <load module="mod_opus"/>

    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>
    <load module="mod_tone_stream"/>
  </modules>
</configuration>
